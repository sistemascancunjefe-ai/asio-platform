# ─── ASIO Platform v2.0 — Environment Variables ──────────────────────
# Copia este archivo como .env en cada app y llena los valores

# ── AI Providers ─────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx        # console.groq.com (FREE)
GROQ_MODEL=llama-3.3-70b-versatile          # Modelo principal

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxx  # console.anthropic.com (fallback)

# ── Telegram ──────────────────────────────────────────────────────────
TELEGRAM_TOKEN=1234567890:AAxxxxxxxxxxxxxx   # @BotFather en Telegram

# ── WhatsApp Business API (Meta) ──────────────────────────────────────
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxx           # Meta for Developers > Token
WHATSAPP_PHONE_ID=123456789012345            # Meta > WhatsApp > Phone Numbers
WHATSAPP_VERIFY_TOKEN=asio_verify_2025       # Token personalizado para webhook

# ── CRM / Lead Capture (opcional) ────────────────────────────────────
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxx     # Notion Integration
NOTION_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Runtime ───────────────────────────────────────────────────────────
ENV=development   # development | production
PORT=8001

# ── Cloudflare (para deploy del Worker) ──────────────────────────────
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxx
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxx
